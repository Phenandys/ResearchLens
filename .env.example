# CORE_API_KEY: Recommended API key from https://core.ac.uk/services/api
# Used exclusively on the Express backend via the Authorization: Bearer header.
# Without a key, CORE API v3 enforces a strict shared IP rate limit (typically 10 requests per 10 minutes).
CORE_API_KEY="YOUR_CORE_API_KEY"

# CORE_API_BASE_URL: Base URL for CORE API v3 (defaults to https://api.core.ac.uk/v3)
CORE_API_BASE_URL="https://api.core.ac.uk/v3"

# PORT: Port used when running the compiled SSR/Express production server
PORT="4000"

# APP_URL: Public URL where the application is hosted
APP_URL="http://localhost:3000"
